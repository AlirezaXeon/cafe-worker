{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cafe-roshan",
  "main": "src/index.js",
  "compatibility_date": "2026-08-14",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/data/products.json"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "PRODUCTS_KV",
      "id": "19ff67341950489da140d84890ab90c5"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cafe-roshan-db",
      "database_id": "63f2d03f-34b1-4bf7-aac0-2d79650e162a"
    }
  ]
}